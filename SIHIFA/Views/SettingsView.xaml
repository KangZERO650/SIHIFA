<UserControl x:Class="SIHIFA.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:SIHIFA.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1050">

    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,30" MaxWidth="900" HorizontalAlignment="Left">
            
            <!-- Page Title -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Pengaturan &amp; Manajemen Data" FontSize="26" FontWeight="Bold" 
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="Konfigurasi preferensi tampilan tema, backup mandiri, dan portabilitas database lokal" 
                           FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Message Banner -->
            <Border Background="{DynamicResource Brush.Accent.Soft}" BorderBrush="{DynamicResource Brush.Accent.Primary}"
                    BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisConverter}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" 
                           Foreground="{DynamicResource Brush.Accent.Primary}" TextWrapping="Wrap" />
            </Border>

            <!-- Section 1: Preferensi Tampilan Antarmuka -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Preferensi Tema Antarmuka" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                    <TextBlock Text="Peralihan tema gelap dan terang instan tanpa perlu memuat ulang aplikasi" 
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Mode Tampilan Gelap (Dark Mode)" FontSize="14" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                            <TextBlock Text="Mengurangi kelelahan mata dengan latar arang gelap dan kontras tinggi" 
                                       FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Toggle CheckBox styled as Switch -->
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" 
                                  VerticalAlignment="Center" Content="Aktifkan Dark Mode" 
                                  FontSize="13" Foreground="{DynamicResource Brush.Text.Primary}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Backup & Pemulihan SQLite (Zero Lock-In) -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Pencadangan &amp; Pemulihan Database SQLite (.db)" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                    <TextBlock Text="Salin utuh seluruh database SQLite lokal Anda untuk cadangan mandiri atau migrasi komputer" 
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,14" />

                    <!-- Database Path Information -->
                    <Border Background="{DynamicResource Brush.Input.Background}" CornerRadius="6" Padding="12,8" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Lokasi Berkas Database Lokal:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Text="{Binding DatabasePath}" FontSize="12" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="💾 Backup Database (.db)..." Style="{StaticResource Style.Button.Primary}"
                                Command="{Binding BackupDatabaseCommand}" Margin="0,0,12,0" />
                        <Button Content="⟳ Pulihkan Database dari Berkas..." Style="{StaticResource Style.Button.Secondary}"
                                Command="{Binding RestoreDatabaseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section 3: Portabilitas Format Universal (JSON & CSV) -->
            <Border Style="{StaticResource Style.Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Ekspor &amp; Impor Format Universal (JSON / CSV)" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                    <TextBlock Text="Pertukaran data koleksi Anda dengan format terbuka yang kompatibel dengan Excel atau skrip lain" 
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Ekspor/Impor JSON -->
                        <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" 
                                CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Format JSON" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBlock Text="Struktur data hierarkis lengkap dengan metadata" FontSize="11" 
                                           Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,12" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ekspor JSON" Style="{StaticResource Style.Button.Secondary}"
                                            Command="{Binding ExportJsonCommand}" Margin="0,0,8,0" Padding="10,5" FontSize="12" />
                                    <Button Content="Impor JSON" Style="{StaticResource Style.Button.Secondary}"
                                            Command="{Binding ImportJsonCommand}" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Ekspor/Impor CSV -->
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="1" 
                                CornerRadius="8" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Format CSV (Spreadsheet)" FontSize="14" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                <TextBlock Text="Format tabel tabular untuk Excel / Google Sheets" FontSize="11" 
                                           Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,12" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ekspor CSV" Style="{StaticResource Style.Button.Secondary}"
                                            Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" Padding="10,5" FontSize="12" />
                                    <Button Content="Impor CSV" Style="{StaticResource Style.Button.Secondary}"
                                            Command="{Binding ImportCsvCommand}" Padding="10,5" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 4: Pengujian Beban & Pemeliharaan (Stress Test 10.000 Data) -->
            <Border Style="{StaticResource Style.Card}">
                <StackPanel>
                    <TextBlock Text="Pengujian Kinerja &amp; Pemeliharaan Penyimpanan" FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,4" />
                    <TextBlock Text="Uji performa scrolling virtualisasi WPF dan efisiensi query pencarian instan (&lt; 50 ms)" 
                               FontSize="12" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,16" />

                    <!-- Stress Test Entry Row -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Stress Test 10.000 Entri Koleksi (PRD Section 15)" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" />
                            <TextBlock Text="Menyuntikkan 10.000 data acak ke database untuk menguji kestabilan CollectionViewSource" 
                                       FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="⚡ Jalankan Stress Test (10k Data)" Style="{StaticResource Style.Button.Secondary}"
                                VerticalAlignment="Center" Command="{Binding RunStressTestCommand}" />
                    </Grid>

                    <!-- Orphaned Cache Cleanup Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Pembersihan Berkas Poster Yatim (Orphaned Cache)" FontSize="13" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Text.Primary}" TextWrapping="Wrap" />
                            <TextBlock Text="Hapus gambar poster di %AppData% yang sudah tidak ditautkan ke entri apapun" 
                                       FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="🧹 Bersihkan File Sampah" Style="{StaticResource Style.Button.Secondary}"
                                VerticalAlignment="Center" Command="{Binding CleanCoversCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
