<UserControl x:Class="SIHIFA.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:SIHIFA.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">
    
    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:RatingFormattedConverter x:Key="RatingFormattedConverter" />
        <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,20,28,30">
            
            <!-- Welcome Header & Quick Action -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dasbor Analitik Media" FontSize="26" FontWeight="Bold" 
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="Ringkasan koleksi, status konsumsi, dan statistik penilaian favorit Anda" 
                               FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="＋ Tambah Media Baru" Style="{StaticResource Style.Button.Primary}"
                            Command="{Binding AddNewCommand}" Margin="0,0,10,0" />
                    <Button Content="Lihat Semua Koleksi →" Style="{StaticResource Style.Button.Secondary}"
                            Command="{Binding NavigateToListCommand}" />
                </StackPanel>
            </Grid>

            <!-- 4 Statistic Summary Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                
                <!-- Card 1: Total Koleksi -->
                <Border Style="{StaticResource Style.Card}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL KOLEKSI" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding TotalCount}" FontSize="32" FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Accent.Primary}" Margin="0,6,0,0" />
                        <TextBlock Text="Seluruh entri media terdata" FontSize="12" 
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Selesai Dinikmati -->
                <Border Style="{StaticResource Style.Card}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SELESAI (COMPLETED)" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding CompletedCount}" FontSize="32" FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Status.Completed}" Margin="0,6,0,0" />
                        <TextBlock Text="Karya selesai dinikmati" FontSize="12" 
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Sedang Berjalan -->
                <Border Style="{StaticResource Style.Card}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SEDANG DINIKMATI" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="{Binding OngoingCount}" FontSize="32" FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Status.Ongoing}" Margin="0,6,0,0" />
                        <TextBlock Text="Sedang ditonton/dibaca" FontSize="12" 
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Rata-rata Skor -->
                <Border Style="{StaticResource Style.Card}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="RATA-RATA PENILAIAN" FontSize="11" FontWeight="Bold" 
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding AverageRating, StringFormat='★ {0:F1}'}" FontSize="32" FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Status.PlanTo}" />
                            <TextBlock Text=" / 10" FontSize="16" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="Indeks kepuasan kurasi" FontSize="12" 
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Charts Section: 2 Columns -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Chart 1: Donut Chart Distribusi Tipe Media -->
                <Border Style="{StaticResource Style.Card}" Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Distribusi Berdasarkan Tipe Media" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="Proporsi Anime, Film, Musik, Buku, dan Materi" FontSize="12" 
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,16" />
                        <lvc:PieChart Series="{Binding TypeSeries}" Height="230" 
                                      LegendPosition="Right" InitialRotation="-90" />
                    </StackPanel>
                </Border>

                <!-- Chart 2: Column Chart Distribusi Rating -->
                <Border Style="{StaticResource Style.Card}" Grid.Column="1" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Distribusi Rentang Rating" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <TextBlock Text="Sebaran nilai dari skor 1 hingga 10" FontSize="12" 
                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,16" />
                        <lvc:CartesianChart Series="{Binding RatingSeries}" XAxes="{Binding RatingXAxes}" Height="230" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Additions Card -->
            <Border Style="{StaticResource Style.Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="Aktivitas Penambahan &amp; Update Terkini" FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                        <Button Content="Buka Koleksi →" HorizontalAlignment="Right" Style="{StaticResource Style.Button.Secondary}"
                                Command="{Binding NavigateToListCommand}" Padding="10,4" FontSize="12" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,0,0,1" 
                                        Padding="6,10" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge Tipe -->
                                        <Border Grid.Column="0" Background="{DynamicResource Brush.Accent.Soft}" 
                                                CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding TipeMedia}" FontSize="11" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource Brush.Accent.Primary}" />
                                        </Border>

                                        <!-- Judul & Genre -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Judul}" FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                            <TextBlock Text="{Binding Genre}" FontSize="11" 
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Badge Status -->
                                        <Border Grid.Column="2" Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" 
                                                Opacity="0.85" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </Border>

                                        <!-- Rating -->
                                        <TextBlock Grid.Column="3" Text="{Binding Rating, Converter={StaticResource RatingFormattedConverter}}" 
                                                   FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.PlanTo}" 
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
