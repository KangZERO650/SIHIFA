<UserControl x:Class="SIHIFA.Views.MediaListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:SIHIFA.Converters"
             xmlns:views="clr-namespace:SIHIFA.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:RatingFormattedConverter x:Key="RatingFormattedConverter" />
        <converters:ImagePathToBitmapConverter x:Key="ImagePathToBitmapConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header & Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Filter bar -->
            <RowDefinition Height="*" />    <!-- Content Area (Table or Cards) -->
            <RowDefinition Height="Auto" /> <!-- Footer stats -->
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Pustaka &amp; Koleksi Media" FontSize="26" FontWeight="Bold" 
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="Katalog terpadu seluruh anime, film, musik, buku, dan materi favorit" 
                           FontSize="13" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Toggle View Mode (Table vs Card) -->
                <Button Command="{Binding ToggleViewModeCommand}" Margin="0,0,10,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Secondary}">
                            <Setter Property="Content" Value="⊞ Tampilan Kartu" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                    <Setter Property="Content" Value="≡ Tampilan Tabel" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Tambah Media Button -->
                <Button Content="＋ Tambah Media" Style="{StaticResource Style.Button.Primary}"
                        Command="{Binding AddNewCommand}" />
            </StackPanel>
        </Grid>

        <!-- Filter & Search Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource Style.Card}" Padding="14,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" /> <!-- Search Box -->
                    <ColumnDefinition Width="Auto" /> <!-- Spacer -->
                    <ColumnDefinition Width="170" /> <!-- Type Filter -->
                    <ColumnDefinition Width="180" /> <!-- Status Filter -->
                    <ColumnDefinition Width="*" />   <!-- Spacer -->
                    <ColumnDefinition Width="Auto" /> <!-- Reset Button -->
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource Style.TextBox.Modern}" Padding="10,8" />
                    <!-- Placeholder text jika kosong -->
                    <TextBlock Text="Cari judul, genre, atau catatan..." FontSize="12"
                               Foreground="{DynamicResource Brush.Text.Muted}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filter Tipe Media -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Tipe:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding TypeFilterOptions}" 
                              SelectedItem="{Binding SelectedTypeFilter}"
                              Style="{StaticResource Style.ComboBox.Modern}" Width="120" />
                </StackPanel>

                <!-- Filter Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Status:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding StatusFilterOptions}" 
                              SelectedItem="{Binding SelectedStatusFilter}"
                              Style="{StaticResource Style.ComboBox.Modern}" Width="120" />
                </StackPanel>

                <!-- Reset Filter Button -->
                <Button Grid.Column="5" Content="↺ Reset Filter" Style="{StaticResource Style.Button.Secondary}"
                        Command="{Binding ResetFiltersCommand}" Padding="10,6" FontSize="12" />
            </Grid>
        </Border>

        <!-- Main Content Area: DataGrid OR Card Gallery -->
        <Grid Grid.Row="2">
            
            <!-- 1. VIRTUALIZED DATAGRID (Table View) -->
            <DataGrid ItemsSource="{Binding FilteredItems}" 
                      SelectedItem="{Binding SelectedItem}">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource Style.DataGrid.Modern}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <!-- Judul & Cover -->
                    <DataGridTemplateColumn Header="JUDUL MEDIA" Width="3*" SortMemberPath="Judul">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Poster Thumbnail -->
                                    <Border Width="30" Height="40" CornerRadius="4" Background="{DynamicResource Brush.Input.Background}"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding PathCoverLocal, Converter={StaticResource ImagePathToBitmapConverter}}"
                                               Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Judul}" FontWeight="SemiBold" FontSize="13" 
                                                   Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Catatan}" FontSize="11" 
                                                   Foreground="{DynamicResource Brush.Text.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tipe Media -->
                    <DataGridTemplateColumn Header="TIPE" Width="1.2*" SortMemberPath="TipeMedia">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Accent.Soft}" CornerRadius="6" 
                                        Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TipeMedia}" FontSize="11" FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush.Accent.Primary}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Genre -->
                    <DataGridTextColumn Header="GENRE" Binding="{Binding Genre}" Width="2*" />

                    <!-- Status -->
                    <DataGridTemplateColumn Header="STATUS" Width="1.8*" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" 
                                        CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.9">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Rating -->
                    <DataGridTemplateColumn Header="RATING" Width="1*" SortMemberPath="Rating">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingFormattedConverter}}" 
                                           FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Status.PlanTo}" 
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Aksi (Detail, Edit, Hapus) -->
                    <DataGridTemplateColumn Header="AKSI" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="👁 Detail" Style="{StaticResource Style.Button.Secondary}" 
                                            Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="✎ Edit" Style="{StaticResource Style.Button.Secondary}" 
                                            Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="✕" Style="{StaticResource Style.Button.Danger}" 
                                            Padding="6,3" FontSize="11"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 2. CARD VIEW (Poster Gallery) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardView}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding FilteredItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Style.Card}" Width="240" Margin="0,0,16,16" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="160" /> <!-- Poster Cover -->
                                        <RowDefinition Height="Auto" /> <!-- Details -->
                                        <RowDefinition Height="Auto" /> <!-- Actions -->
                                    </Grid.RowDefinitions>

                                    <!-- Clickable Card Area for Details -->
                                    <Border Grid.Row="0" Grid.RowSpan="2" Cursor="Hand" Background="Transparent" Panel.ZIndex="1">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" 
                                                          Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                    </Border>

                                    <!-- Poster Image -->
                                    <Border Grid.Row="0" CornerRadius="12,12,0,0" Background="{DynamicResource Brush.Input.Background}">
                                        <Image Source="{Binding PathCoverLocal, Converter={StaticResource ImagePathToBitmapConverter}}"
                                               Stretch="UniformToFill" />
                                    </Border>

                                    <!-- Rating Badge Top-Right -->
                                    <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="2"
                                            Margin="8" CornerRadius="6" Background="#CC000000" Padding="6,3">
                                        <TextBlock Text="{Binding Rating, Converter={StaticResource RatingFormattedConverter}}" 
                                                   FontSize="12" FontWeight="Bold" Foreground="#F59E0B" />
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Row="1" Margin="14,10,14,8">
                                        <TextBlock Text="{Binding Judul}" FontSize="14" FontWeight="Bold" 
                                                   Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Genre}" FontSize="11" 
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,3,0,6" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border Background="{DynamicResource Brush.Accent.Soft}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding TipeMedia}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent.Primary}" />
                                            </Border>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons Footer -->
                                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Card.Border}" BorderThickness="0,1,0,0" Padding="12,8" Panel.ZIndex="2">
                                        <Grid>
                                            <!-- Detail Button on Left -->
                                            <Button Content="👁 Detail" Style="{StaticResource Style.Button.Primary}" 
                                                    HorizontalAlignment="Left" Padding="10,4" FontSize="11"
                                                    Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />

                                            <!-- Edit & Delete Buttons on Right -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="✎ Edit" Style="{StaticResource Style.Button.Secondary}" 
                                                        Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="Hapus" Style="{StaticResource Style.Button.Danger}" 
                                                        Padding="8,4" FontSize="11"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>

        <!-- Footer Stats Bar -->
        <Border Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding ItemCount, StringFormat='Menampilkan {0} entri media yang sesuai kriteria'}" 
                       FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}" />
        </Border>

        <!-- ===================== DETAIL MODAL OVERLAY ===================== -->
        <Grid Grid.RowSpan="4" Background="#B3000000" Margin="-28,-20,-28,-24"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisConverter}}"
              d:Visibility="Collapsed">
            <views:MediaDetailDialog HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
