<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Palette (Modern Slate Navy / Dark Charcoal) -->
    <SolidColorBrush x:Key="Brush.Window.Background" Color="#0B0F17" />
    <SolidColorBrush x:Key="Brush.Sidebar.Background" Color="#111827" />
    <SolidColorBrush x:Key="Brush.Header.Background" Color="#111827" />
    <SolidColorBrush x:Key="Brush.Card.Background" Color="#1E293B" />
    <SolidColorBrush x:Key="Brush.Card.Hover" Color="#283548" />
    <SolidColorBrush x:Key="Brush.Card.Border" Color="#334155" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#64748B" />

    <!-- Accents -->
    <SolidColorBrush x:Key="Brush.Accent.Primary" Color="#3B82F6" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#1E3A8A" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="#FFFFFF" />

    <!-- Badges / Status Indicators -->
    <SolidColorBrush x:Key="Brush.Status.Completed" Color="#10B981" />
    <SolidColorBrush x:Key="Brush.Status.Ongoing" Color="#3B82F6" />
    <SolidColorBrush x:Key="Brush.Status.PlanTo" Color="#F59E0B" />
    <SolidColorBrush x:Key="Brush.Status.OnHold" Color="#8B5CF6" />
    <SolidColorBrush x:Key="Brush.Status.Dropped" Color="#EF4444" />

    <!-- Inputs & Controls -->
    <SolidColorBrush x:Key="Brush.Input.Background" Color="#162032" />
    <SolidColorBrush x:Key="Brush.Input.Border" Color="#334155" />
    <SolidColorBrush x:Key="Brush.Input.FocusBorder" Color="#3B82F6" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="Brush.DataGrid.HeaderBackground" Color="#162032" />
    <SolidColorBrush x:Key="Brush.DataGrid.RowBackground" Color="#1E293B" />
    <SolidColorBrush x:Key="Brush.DataGrid.RowAlt" Color="#192335" />
    <SolidColorBrush x:Key="Brush.DataGrid.RowHover" Color="#27364D" />
    <SolidColorBrush x:Key="Brush.DataGrid.RowSelected" Color="#1E3A8A" />
    <SolidColorBrush x:Key="Brush.DataGrid.GridLine" Color="#253247" />

    <!-- ScrollBar -->
    <SolidColorBrush x:Key="Brush.ScrollBar.Thumb" Color="#475569" />
    <SolidColorBrush x:Key="Brush.ScrollBar.ThumbHover" Color="#64748B" />
    <SolidColorBrush x:Key="Brush.ScrollBar.Track" Color="#0B0F17" />

</ResourceDictionary>
